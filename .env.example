# Copy to .env.local for development. Never commit real values.

# ---- Database (Neon in production; `npm run db:local` for a local server)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/nursing_level_up

# ---- Auth (NextAuth / Auth.js v5)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Public URL of the app (used for OAuth callbacks)
AUTH_URL=http://localhost:3000
# Google OAuth client (https://console.cloud.google.com/apis/credentials)
# Authorised redirect URI: {AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Development-only email login that bypasses Google. Ignored when NODE_ENV=production.
ENABLE_DEV_LOGIN=true

# ---- Payments (Razorpay — https://dashboard.razorpay.com/app/keys; use rzp_test_ keys in dev)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook URL: {AUTH_URL}/api/payments/razorpay/webhook  events: payment.captured, payment.failed, order.paid, refund.processed
RAZORPAY_WEBHOOK_SECRET=
# ---- Object storage (Neon DB / S3-compatible). If unset, uploads are stored under ./.uploads (dev only)
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# ---- OCR / AI MCQ generation (free tiers)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OCRSPACE_API_KEY=

# ---- Public (safe for the browser)
NEXT_PUBLIC_APP_URL=http://localhost:3000
